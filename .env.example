# Qdrant connection (required for ingestion into your cluster).
QDRANT_CLUSTER_ENDPOINT=
QDRANT_API_KEY=

# Optional LLM provider keys.
GROQ_API_KEY=
GROQ_FALLBACK_API_KEY=
GEMINI_API_KEY=

# Optional: leave unset or empty to use the local embedding fallback.
JINA_API_KEY=

# Optional: uncomment when running without Logfire configuration.
# This suppresses its startup warning; it does not enable logging or tracing.
# LOGFIRE_IGNORE_NO_CONFIG=1
